# Copiá este archivo a .env y completá. Nunca subas .env al repo.

# --- IOL (pedí acceso a la API desde tu cuenta de IOL) ---
IOL_USER=tu_usuario
IOL_PASS=tu_password
IOL_PANEL=todos

# --- Ejecución ---
# alerta: el bot detecta y te avisa por Telegram con monto y tasa exactos.
# iol:    envía la orden por API (requiere completar IOLClient.colocar_caucion).
MODO=alerta
# true: no ejecuta nada, solo simula y registra. Dejalo así las primeras semanas.
DRY_RUN=true

# --- Horarios (Buenos Aires). Verificá el horario de cauciones de IOL. ---
HORA_INICIO=11:05
HORA_VENTANA=16:15
HORA_LIMITE=16:52
CADA_SEG=300
CADA_SEG_VENTANA=30

# --- Qué es una "disparada" ---
# Umbral = base + max(SALTO_PP, base * SALTO_PCT / 100)
SALTO_PP=4
SALTO_PCT=15
CONFIRMACIONES=2
DIAS_HISTORIA=10
# Liquidez mínima del plazo (monto operado en el día, en pesos)
MIN_MONTO_OPERADO=50000000

# --- Costos y pisos ---
# Costo total anualizado de colocar (arancel IOL + derechos de mercado), en pp de TNA.
# El 2 es un placeholder: sacá el número real del tarifario de IOL.
COSTOS_PP=2
# No colocar si la TNA neta queda por debajo de esto (ej: la TNA de tu money market).
MIN_TNA_NETA=0
SLIPPAGE_PP=0.5
# false: a la hora límite coloca igual aunque no haya disparada (si supera MIN_TNA_NETA)
SOLO_DISPARADA=true

# --- Montos (pesos) ---
RESERVA=0
MONTO_MAX=100000000
MONTO_MIN=10000

# --- Avisos (opcional) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

DB_PATH=caucionbot.sqlite
