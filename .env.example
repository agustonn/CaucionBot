# Copiá este archivo a .env y completá. Nunca subas .env al repo.

# --- Broker ---
# ppi: opera punta a punta (API oficial con COLOCAR-CAUCION)
# iol: solo detecta y avisa (la API de IOL no permite operar cauciones)
BROKER=ppi

# --- PPI (en tu cuenta: Gestiones -> Gestión de servicio API) ---
# Sandbox: AuthorizedClient y ClientKey te llegan por mail. Producción: están en tu cuenta.
PPI_AUTHORIZED_CLIENT=
PPI_CLIENT_KEY=
PPI_KEY=
PPI_SECRET=
# true = ambiente de pruebas de PPI (no mueve plata). Cambialo a false para operar en serio.
PPI_SANDBOX=true
# Opcional: si tenés más de una cuenta comitente
PPI_CUENTA=
# Opcional. Por defecto usa PESOS1, PESOS2, ... (verificado en PPI). Solo para forzar otros:
# CAUCION_TICKERS=PESOS1:1,PESOS3:3
CAUCION_TICKERS=
# Cuántos plazos muestran probe y doctor. El bot siempre usa el del próximo hábil.
MAX_DIAS=4

# --- IOL (solo si BROKER=iol) ---
IOL_USER=
IOL_PASS=
IOL_PANEL=todos

# --- Ejecución ---
# auto:      envía la orden sola.
# confirmar: te muestra la orden en la consola y espera tu "s" (recomendado para las primeras veces).
# alerta:    solo avisa por Telegram, la colocás vos.
MODO=auto
# MODO=confirmar: segundos para responder. Sin respuesta no envía y vuelve a preguntar
# en la próxima evaluación si sigue la disparada. Responder "n" corta los tramos del día.
CONFIRMAR_SEG=45
# true: no ejecuta nada, solo simula y registra. Dejalo así las primeras semanas.
DRY_RUN=true

# --- Horarios (Buenos Aires) ---
HORA_INICIO=11:05
# Desde acá busca disparadas. Lo de antes se usa para calcular la tasa normal del día.
HORA_VENTANA=16:15
# A esta hora coloca todo lo que sobró. La rueda cierra a las 17:00. Acepta HH:MM:SS.
HORA_LIMITE=16:58:30
CADA_SEG=300
CADA_SEG_VENTANA=15

# --- Qué es una "disparada" ---
# Tasa de ahora = promedio de los últimos MINUTOS_TASA minutos ponderado por volumen.
# Tasa normal  = mediana del día antes de HORA_VENTANA, ponderada por volumen.
# Se disparó si, durante CONFIRMACIONES minutos seguidos:
#   tasa de ahora >= FACTOR_DISPARADA x tasa normal       (1.5 = 50% más; con 19% normal, desde 28,5%)
#   volumen de esos minutos >= FACTOR_VOLUMEN x el típico (0 = no exigir volumen)
FACTOR_DISPARADA=1.5
FACTOR_VOLUMEN=1.0
MINUTOS_TASA=3
CONFIRMACIONES=2
DIAS_HISTORIA=10
# Volumen mínimo para considerar la cotización. Dejalo en 0.
MIN_MONTO_OPERADO=0

# --- Órdenes durante la disparada ---
# Cada orden es TRAMO_PCT % del capital del día (saldo + lo ya colocado hoy, con tope MONTO_MAX).
TRAMO_PCT=20
# La siguiente orden sale cuando la tasa supera en este % a la anterior (15: de 60% a 69%).
SALTO_TRAMO_PCT=15
TRAMOS_MAX=10
# false: a HORA_LIMITE coloca todo lo que sobró aunque no haya disparada (mejor rendir algo que 0).
# true:  solo coloca si hubo disparada.
SOLO_DISPARADA=false

# --- Costos y pisos ---
# Costo anualizado de colocar, en pp de TNA. Medido en PPI el 19/11/2026: 2,47.
COSTOS_PP=2.5
# No colocar si la TNA neta queda por debajo de esto.
MIN_TNA_NETA=0
SLIPPAGE_PP=0.5

# --- Montos (pesos). PPI pide mínimo AR$100.000 por caución. ---
RESERVA=0
# Capital máximo que el bot pone por día
MONTO_MAX=1000000
MONTO_MIN=100000

# --- Avisos (opcional) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

DB_PATH=caucionbot.sqlite
