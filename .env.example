# Copiá este archivo a .env y completá. Nunca subas .env al repo.

# --- Broker ---
# ppi: opera punta a punta (API oficial con COLOCAR-CAUCION)
# iol: solo detecta y avisa (la API de IOL no permite operar cauciones)
BROKER=ppi

# --- PPI (en tu cuenta: Gestiones -> Gestión de servicio API) ---
# Sandbox: AuthorizedClient y ClientKey te llegan por mail. Producción: están en tu cuenta.
PPI_AUTHORIZED_CLIENT=
PPI_CLIENT_KEY=
PPI_KEY=
PPI_SECRET=
# true = ambiente de pruebas de PPI (no mueve plata). Cambialo a false para operar en serio.
PPI_SANDBOX=true
# Opcional: si tenés más de una cuenta comitente
PPI_CUENTA=
# Opcional. Por defecto usa PESOS1, PESOS2, ... (verificado en PPI). Solo para forzar otros:
# CAUCION_TICKERS=PESOS1:1,PESOS3:3
CAUCION_TICKERS=
# Ignorar plazos más largos (3 cubre fines de semana, 4 fines de semana largos)
MAX_DIAS=4

# --- IOL (solo si BROKER=iol) ---
IOL_USER=
IOL_PASS=
IOL_PANEL=todos

# --- Ejecución ---
# auto: envía la orden. alerta: solo avisa por Telegram.
MODO=auto
# true: no ejecuta nada, solo simula y registra. Dejalo así las primeras semanas.
DRY_RUN=true

# --- Horarios (Buenos Aires) ---
HORA_INICIO=11:05
HORA_VENTANA=16:15
HORA_LIMITE=16:52
CADA_SEG=300
CADA_SEG_VENTANA=30

# --- Qué es una "disparada" ---
# Umbral = base + max(SALTO_PP, base * SALTO_PCT / 100)
SALTO_PP=4
SALTO_PCT=15
CONFIRMACIONES=2
DIAS_HISTORIA=10
# Volumen mínimo para considerar la cotización. PPI informa 0 en cauciones: dejalo en 0.
MIN_MONTO_OPERADO=0

# --- Costos y pisos ---
# Costo anualizado de colocar, en pp de TNA. PPI: 2% + IVA = 2.42 (verificá el tarifario vigente).
COSTOS_PP=2.42
# No colocar si la TNA neta queda por debajo de esto (ej: la TNA de un money market).
MIN_TNA_NETA=0
SLIPPAGE_PP=0.5
# false: a la hora límite coloca igual aunque no haya disparada (si supera MIN_TNA_NETA)
SOLO_DISPARADA=true

# --- Montos (pesos). PPI pide mínimo AR$100.000 por caución. ---
RESERVA=0
MONTO_MAX=100000000
MONTO_MIN=100000

# --- Avisos (opcional) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

DB_PATH=caucionbot.sqlite
